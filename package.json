{
  "name": "connectme",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectMe: social media app with end-to-end encrypted chats",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build -w @connectme/shared && npm run build -w @connectme/api",
    "dev:api": "npm run dev -w @connectme/api",
    "start:mobile": "npm run start -w @connectme/mobile",
    "android": "npm run android -w @connectme/mobile",
    "certs": "node scripts/gen-certs.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
