{
  "name": "@connectme/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --dev-client",
    "android": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@connectme/shared": "0.1.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.19",
    "expo-dev-client": "58.0.15",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.20",
    "jest-expo": "58.0.12",
    "test-renderer": "1.3.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@connectme/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    }
  }
}
